# Required. Create this with @BotFather and store the real value only in your
# deployment platform's secret environment variables.
TELEGRAM_BOT_TOKEN=

# Required. Comma-separated numeric Telegram chat IDs. The bridge fails closed
# when this is empty. If you do not know the ID yet, start once and check logs
# after sending the bot a message; unauthorized chat IDs are logged.
TELEGRAM_ALLOWED_CHAT_IDS=

# Directory whose most recent Claude Code conversation should be continued.
CLAUDE_WORKDIR=/workspace

# Optional. The executable can be an absolute path.
CLAUDE_COMMAND=claude

# Optional JSON array of extra Claude Code arguments.
# Example: ["--model","sonnet"]
# Do not enable --dangerously-skip-permissions unless you understand the risk.
CLAUDE_EXTRA_ARGS_JSON=[]

# Stop one Claude turn after this many milliseconds. It is never auto-retried.
CLAUDE_TIMEOUT_MS=300000

# Persistent storage is strongly recommended on hosted platforms.
STATE_DIR=/data/claude-p-telegram

# Optional health server for platforms such as Zeabur.
PORT=3000

# Optional proactive heartbeat. Disabled when set to 0.
HEARTBEAT_INTERVAL_MINUTES=0
HEARTBEAT_CHAT_ID=
HEARTBEAT_SILENT_TOKEN=SILENT
HEARTBEAT_PROMPT=This is an optional scheduled check-in. Reply SILENT if there is nothing useful to say; otherwise write one short message to the person in this chat.
